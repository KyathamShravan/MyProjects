@page
@model UserManagement.Pages.Users.IndexModel
@{
}
<h2 class="text-center mb-3">UserData</h2>
<a asp-page="/Users/Create" class="btn btn-primary mb-3">Create New User</a>
<table class="table table-striped">
	<thead>
		<tr>
			<th>User ID</th>
			<th>Username</th>
			<th>Email</th>
			<th>Action</th>		
			
		</tr>
	</thead>
	<tbody>
		@foreach (var user in Model.UserDataList)
		{
			<tr>
				<td>@user.Id</td>
				<td>@user.UserName</td>
				<td>@user.UserEmail</td>
				<td style="white-space:nowrap">
					<a asp-page="/Users/Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning">Edit</a>
					<a asp-page="/Users/Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger">Delete</a>
				</td>
				
			</tr>
		}
	</tbody>
	</table>